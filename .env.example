# Supabase
# 在 Supabase 项目设置 -> API 中查找
NEXT_PUBLIC_SUPABASE_URL=https://your-project-id.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# DeepSeek API
# 在 DeepSeek 开放平台获取
DEEPSEEK_API_KEY=your-deepseek-api-key

# Tailwind (可选) — 如果构建环境缺少原生 oxide 依赖，启用此项以使用 JS/WASM 实现
# TAILWIND_DISABLE_OXIDE=1

# 定时保活任务（可选）— 用于防止 Supabase 免费版项目因长期无请求而自动暂停
# 设置后，/api/cron/keep-alive 会要求 Authorization: Bearer <CRON_SECRET>
# Vercel Cron 会自动携带此 header；Netlify 定时函数已配置为同样携带
# CRON_SECRET=生成一个随机字符串
